VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Somente servidor (NUNCA usar prefixo VITE_: tudo com VITE_ vai para o código do site) ----
# PIN único da equipe de closers e PIN do admin. Para trocar: edite nas Environment Variables
# do Vercel e faça Redeploy. Use pelo menos 6 dígitos.
TEAM_PIN=change-me
ADMIN_PIN=change-me
# Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Endereço oficial do site (usado nos QR Codes dos crachás). Ex: https://helper-imersao-rise.vercel.app
VITE_PUBLIC_SITE_URL=

# Só para scripts que sobem fotos no Vercel Blob (o site não usa)
BLOB_READ_WRITE_TOKEN=
